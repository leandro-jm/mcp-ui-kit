{
  "name": "@mcp-ui-kit/example-chat-external",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Minimal chat that consumes an MCP server with MCP Apps (e.g. mcp-gateway) and renders tool views with @mcp-ui-kit/host.",
  "scripts": {
    "build": "vite build",
    "start": "tsx server.ts",
    "dev": "vite build && tsx server.ts",
    "typecheck": "tsc -p tsconfig.json",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@hono/node-server": "^2.1.4",
    "@mcp-ui-kit/host": "workspace:*",
    "@modelcontextprotocol/client": "^2.3.1",
    "@modelcontextprotocol/core": "^2.3.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "hono": "^4.13.13",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tsx": "^4.23.15",
    "vite": "^8.3.4"
  }
}
