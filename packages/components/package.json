{
  "name": "@mcp-ui-kit/components",
  "version": "0.1.0",
  "description": "React renderers for @mcp-ui-kit/view-spec: tables, charts, cards, forms, confirmation plans, maps and diagrams for MCP tool results.",
  "license": "Apache-2.0",
  "author": "Leandro Martins (https://github.com/leandro-jm)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leandro-jm/mcp-ui-kit.git",
    "directory": "packages/components"
  },
  "homepage": "https://github.com/leandro-jm/mcp-ui-kit/tree/main/packages/components#readme",
  "bugs": "https://github.com/leandro-jm/mcp-ui-kit/issues",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "generative-ui",
    "react",
    "components"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "mcp-ui-kit-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./map": {
      "mcp-ui-kit-source": "./src/map.tsx",
      "types": "./dist/map.d.ts",
      "import": "./dist/map.js"
    },
    "./mermaid": {
      "mcp-ui-kit-source": "./src/mermaid.tsx",
      "types": "./dist/mermaid.d.ts",
      "import": "./dist/mermaid.js"
    },
    "./styles.css": "./src/styles.css"
  },
  "files": [
    "dist",
    "src/styles.css",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/map.tsx src/mermaid.tsx --format esm --clean --external react --external leaflet --external mermaid --external @mcp-ui-kit/view-spec && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@cfworker/json-schema": "^4.1.1",
    "@mcp-ui-kit/view-spec": "workspace:*"
  },
  "peerDependencies": {
    "leaflet": "^1.9.4",
    "mermaid": "^12.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "leaflet": {
      "optional": true
    },
    "mermaid": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "happy-dom": "^20.14.6",
    "leaflet": "^1.9.4",
    "mermaid": "^12.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
